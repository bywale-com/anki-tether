{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored Anki Tether flashcard batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "course", "deck", "cards"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "course": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$", "maxLength": 40},
    "deck": {"type": "string", "minLength": 1, "maxLength": 160},
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "front", "back"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}(?![\\s\\S])"},
          "front": {"type": "string", "minLength": 1, "maxLength": 8000},
          "back": {"type": "string", "minLength": 1, "maxLength": 8000},
          "tags": {
            "type": "array", "maxItems": 30, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"}
          },
          "origin": {"const": "authored"},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
