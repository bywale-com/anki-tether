    {
      "id": "math1110-found-trig-tan-def",
      "front": "Express \\(\\tan x\\) using sine and cosine.",
      "back": "\\(\\tan x=\\sin x/\\cos x\\), wherever \\(\\cos x\\ne0\\).",
