# Study UI login (required in production)
STUDY_USERNAME=wale
STUDY_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Collection on the persistent volume
ANKI_DATA_DIR=/data
ANKI_COLLECTION=/data/collection.anki2

# Bind
HOST=0.0.0.0
PORT=8000

# GitHub Actions -> app import (required to publish cards)
IMPORT_TOKEN=generate-another-long-random-string

# Optional OpenAI-compatible provider for interpretive cards
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: auto-publish only high-confidence deterministic cards from CI
AUTO_PUBLISH_HIGH_CONFIDENCE=false
STUDY_APP_URL=
